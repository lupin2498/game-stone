{
  "name": "stone-balance",
  "version": "1.0.0",
  "private": true,
  "description": "Cân Bằng Đá - Stone Balance",
  "scripts": {
    "sync:web": "node scripts/copy-web.js",
    "sync": "npm run sync:web && cap sync",
    "icons": "capacitor-assets generate --iconBackgroundColor #0b1020 --splashBackgroundColor #0b1020",
    "android:apk": "npm run sync:web && cap sync android && cd android && ./gradlew assembleDebug",
    "ios:open": "npm run sync:web && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
